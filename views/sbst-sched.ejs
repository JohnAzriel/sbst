<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/logo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="css/sbst.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <title>SBST | Schedules</title>
</head>
<body>
    <section>
        <!-- navbar -->
        <nav class="navbar navbar-expand-lg">
            <div class="container">
              <!-- Left-aligned logo and text -->
              <a class="navbar-brand d-flex align-items-center">
                <img src="images/logo.png" alt="sbst-logo" class="me-2">
                <span class="sbst-logo-text">Southern Baptist School of Theology Inc.</span>
              </a>
          
              <!-- Hamburger menu for smaller screens -->
              <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
          
              <!-- Right-aligned navigation items with even spacing -->
              <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
                <ul class="navbar-nav">
                  <li class="nav-item mx-2">
                    <a class="nav-link ajax-link" href="/sbst-home" data-page="sbst-home">Home</a>
                  </li>
                  <li class="nav-item dropdown mx-2">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                      Programs
                    </a>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item"><h5>Ministries Programs:</h5></a></li>
                      <li><hr class="dropdown-divider"></li>
                      <li><a class="dropdown-item" href="/masters-of-divinity">
                        <h5>Masters of Divinity</h5>
                        <small class="text-muted">Major in Theology and Missiology</small>
                      </a></li>
                      <li><a class="dropdown-item" href="/major-in-biblical-studies-and-church-planting">
                        <h5>Masters of Arts and Ministry</h5>
                        <small class="text-muted">Major in Biblical Studies and Church Planting</small>
                      </a></li>
                      <li><a class="dropdown-item" href="/major-in-preaching-administration-counseling">
                        <h5>Masters of Theology</h5>
                        <small class="text-muted">Major in Preaching; Administration; Counseling</small>
                      </a></li>
                      <li><a class="dropdown-item" href="/major-in-children-and-youth-ministry">
                        <h5>Masters of Christian Education</h5>
                        <small class="text-muted">Major in Children and Youth Ministry</small>
                      </a></li>
                      <li><hr class="dropdown-divider"></li>
                      <li><a class="dropdown-item" href="/ministry-in-christian-music">
                        <h5>Ministry in Christian Music</h5>
                      </a></li>
                      <li><a class="dropdown-item" href="/associate-in-ministerial-training">
                        <h5>Associate in Ministerial Training</h5>
                      </a></li>
                      <li><a class="dropdown-item" href="/theological-education-by-extension">
                        <h5>Theological Education by Extension</h5>
                      </a></li>
                      <li><a class="dropdown-item" href="/community-outreach-program">
                        <h5>Community Outreach Program</h5>
                      </a></li>
                    </ul>
                  </li>
                  <li class="nav-item mx-2">
                    <a class="nav-link ajax-link active" href="/sbst-sched" data-page="sbst-sched">Schedules</a>
                  </li>
                  <li class="nav-item mx-2">
                    <a class="nav-link ajax-link" href="/sbst-about" data-page="sbst-about">About</a>
                  </li>
                  <li class="nav-item mx-2">
                    <a class="nav-link ajax-link" href="/sbst-apply" data-page="sbst-apply">Apply</a>
                  </li>
                </ul>
              </div>
            </div>
          </nav>

          <!-- Main Content Section -->
            <div class="sched-content">
              <div class="sched-container">
                <h2 class="sched-title">Class Schedule</h2>
                <h4 class="sched-subtitle">First Semester | S.Y. 2025-2026</h4>
                <table class="table table-striped table-bordered text-center table-responsive">
                  <thead>
                      <tr>
                          <th>Course</th>
                          <th>Instructor</th>
                          <th>Unit</th>
                          <th>Day</th>
                          <th>Time</th>
                      </tr>
                  </thead>
                  <tbody>
                    <% if (typeof result !== 'undefined' && Array.isArray(result)) { %>
                        <% result.forEach(course => { %>
                            <tr>
                                <td><%= course.course_name %></td>
                            <td><%= course.instructor %></td>
                            <td><%= course.unit %></td>
                            <td><%= course.day %></td>
                            <td><%= course.time %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="2">Unable to load data from the database.</td>
                        </tr>
                    <% } %>
                      <!-- <% result.forEach(course => { %>
                          <tr>
                            <td><%= course.course_name %></td>
                            <td><%= course.instructor %></td>
                            <td><%= course.unit %></td>
                            <td><%= course.day %></td>
                            <td><%= course.time %></td>
                          </tr>
                        <% }); %> -->
                  </tbody>
              </table>
            </div>
            <!-- Instructors Views -->
            </div>
          </div>  
    </section>
    <!-- Footer Section -->
    <footer class="footer">
      <!-- Footer Bottom Row -->
        <div class="copyright row">
          <div class="copyright-content col-md-12 text-center pt-2 mt-2">
          <p>
              <span>Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved. Southern Baptist School of Theology Inc.</span>
          </p>
          </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/js/sbst.js"></script>
</body>
</html>